# --- Model provider ---
# Required by agents using OpenAI models (e.g. the bundled weather-agent on openai/gpt-5-mini).
# Using another provider? Set its key instead (e.g. ANTHROPIC_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY).
OPENAI_API_KEY=sk-...

# --- Rallya API ---
# Base URL of the Rallya API (defaults to http://localhost:8080/api/v1 when unset).
RALLYA_BASE_URL=http://localhost:8080/api/v1

# Server-to-server org key (rk_live_*). PREFERRED auth for agents: no refresh dance.
# Pick this OR the user-JWT pair below — never both.
RALLYA_API_KEY=rk_live_...

# --- Rallya auth fallback (user JWT session) ---
# Only needed when RALLYA_API_KEY is not set. Access JWT is short-lived (15 min);
# the client auto-refreshes on 401 when a refresh token is present.
# RALLYA_ACCESS_TOKEN=eyJ...
# RALLYA_REFRESH_TOKEN=...

# --- Code Mode (QuickJS) tuning — all optional ---
# Heap limit in MiB per code-mode run (default 128).
# RALLYA_CODEMODE_MEMORY_MB=128
# Execution timeout in ms per code-mode run (default 30000).
# RALLYA_CODEMODE_TIMEOUT_MS=30000

# --- Agent model + memory observer — all optional ---
# Agent model id (default ollama-cloud/gpt-oss:120b).
# RALLYA_AGENT_MODEL=openai/gpt-5-mini
# Observer/Reflector model for observational memory (default openai/gpt-5-mini).
# Needs its own provider key.
# RALLYA_MEMORY_MODEL=openai/gpt-5-mini
# Small model for guardrail classification (default openai/gpt-5-nano).
# RALLYA_GUARDRAIL_MODEL=openai/gpt-5-nano
# Cost backstop in USD per thread per 24h, warn-only (default 5).
# RALLYA_MAX_COST_USD=5

# --- Auth model: operator JWT + per-request Rallya identity ---
# Edge gate:  Authorization: Bearer <mastra-jwt> (signed with MASTRA_JWT_SECRET).
# Identity:   X-Rallya-Access-Token: <rallya-jwt> (+ optional X-Rallya-Refresh-Token),
#             or X-Rallya-Api-Key: rk_live_... for tablets/cron.
# Obtain Rallya tokens via POST /rallya-auth/register|login|refresh (public).
# In Studio set both headers via the Headers editor.

# --- Mastra operator auth (required) ---
# HS256 secret signing operator JWTs for Mastra server auth.
# Generate: openssl rand -base64 48. Must match the secret that signs tokens.
MASTRA_JWT_SECRET=supersecretdevkeythatishs256safe!

# --- Storage: PostgreSQL (production) ---
# Set DATABASE_URL to use Postgres for memory, threads, workflows + traces.
# Unset = local dev fallback (file:./mastra.db + DuckDB observability).
# Example: postgresql://user:pass@host:5432/dbname
# DATABASE_URL=postgresql://user:pass@localhost:5432/rallya
# Managed PG (Neon/Supabase/RDS) usually needs SSL:
# DATABASE_SSL=true
# Optional pool tuning (defaults 20 / 30000):
# PG_POOL_MAX=20
# PG_IDLE_TIMEOUT_MS=30000

# --- Mastra Cloud — optional, local dev only ---
# Enables the platform observability exporter. Omit for local development.
# MASTRA_PLATFORM_ACCESS_TOKEN=...
