# --- Model provider ---
# Required by agents using OpenAI models (e.g. the bundled weather-agent on openai/gpt-5-mini).
# Using another provider? Set its key instead (e.g. ANTHROPIC_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY).
OPENAI_API_KEY=sk-...

# --- Rallya API ---
# Base URL of the Rallya API (defaults to http://localhost:8080/api/v1 when unset).
RALLYA_BASE_URL=http://localhost:8080/api/v1

# Server-to-server org key (rk_live_*). PREFERRED auth for agents: no refresh dance.
# Pick this OR the user-JWT pair below — never both.
RALLYA_API_KEY=rk_live_...

# --- Rallya auth fallback (user JWT session) ---
# Only needed when RALLYA_API_KEY is not set. Access JWT is short-lived (15 min);
# the client auto-refreshes on 401 when a refresh token is present.
# RALLYA_ACCESS_TOKEN=eyJ...
# RALLYA_REFRESH_TOKEN=...

# --- Code Mode (QuickJS) tuning — all optional ---
# Heap limit in MiB per code-mode run (default 128).
# RALLYA_CODEMODE_MEMORY_MB=128
# Execution timeout in ms per code-mode run (default 30000).
# RALLYA_CODEMODE_TIMEOUT_MS=30000

# --- Mastra Cloud — optional, local dev only ---
# Enables the platform observability exporter. Omit for local development.
# MASTRA_PLATFORM_ACCESS_TOKEN=...
